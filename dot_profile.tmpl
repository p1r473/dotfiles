# ~/.profile: executed by Bourne-compatible login shells.

if [ -n "${BASH_VERSION:-}" ] && [ -r "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi

if [ -r "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

_profile_zsh=
case $- in
  *i*)
    if [ -z "${ZSH_VERSION:-}" ]; then
      _profile_zsh=$(command -v zsh 2>/dev/null) || _profile_zsh=
      if [ -n "$_profile_zsh" ] && [ -x "$_profile_zsh" ]; then
        export SHELL="$_profile_zsh"
      else
        _profile_zsh=
      fi
    fi
    ;;
esac

_profile_byobu=/usr/bin/byobu-launch
if [ ! -r "$_profile_byobu" ]; then
  _profile_byobu=$(command -v byobu-launch 2>/dev/null) || _profile_byobu=
fi
if [ -n "$_profile_byobu" ] && [ -r "$_profile_byobu" ]; then
  _byobu_sourced=1 . "$_profile_byobu" 2>/dev/null || true
fi
unset _profile_byobu

if [ -n "$_profile_zsh" ]; then
  exec "$_profile_zsh" -l
fi
unset _profile_zsh
